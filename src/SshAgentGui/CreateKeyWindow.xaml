<Window x:Class="SshAgentGui.CreateKeyWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Create key"
        Width="520"
        Height="360"
        MinWidth="480"
        MinHeight="340"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="110"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>

        <Label Grid.Row="0" Grid.Column="0" Content="Type" VerticalAlignment="Center"/>
        <ComboBox x:Name="TypeBox" Grid.Row="0" Grid.Column="1" Grid.ColumnSpan="2"
                  Margin="0,4" SelectedIndex="0" SelectionChanged="OnTypeChanged">
            <ComboBoxItem Content="Ed25519"/>
            <ComboBoxItem Content="RSA 4096"/>
        </ComboBox>

        <Label Grid.Row="1" Grid.Column="0" Content="File" VerticalAlignment="Center"/>
        <TextBox x:Name="PathBox" Grid.Row="1" Grid.Column="1" Margin="0,4" VerticalAlignment="Center"/>
        <Button Grid.Row="1" Grid.Column="2" Content="Browse…" Margin="8,4,0,4" Click="OnBrowseClick"/>

        <Label Grid.Row="2" Grid.Column="0" Content="Comment" VerticalAlignment="Center"/>
        <TextBox x:Name="CommentBox" Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2" Margin="0,4"/>

        <Label Grid.Row="3" Grid.Column="0" Content="Passphrase" VerticalAlignment="Center"/>
        <PasswordBox x:Name="PassphraseBox" Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="2" Margin="0,4"/>

        <Label Grid.Row="4" Grid.Column="0" Content="Confirm" VerticalAlignment="Center"/>
        <PasswordBox x:Name="ConfirmBox" Grid.Row="4" Grid.Column="1" Grid.ColumnSpan="2" Margin="0,4"/>

        <CheckBox x:Name="LoadBox" Grid.Row="5" Grid.Column="1" Grid.ColumnSpan="2"
                  Margin="0,10,0,0" Content="Load into agent now" IsChecked="True"/>

        <TextBlock x:Name="ErrorText" Grid.Row="6" Grid.Column="0" Grid.ColumnSpan="3"
                   Margin="0,10,0,0" Foreground="#B00020" TextWrapping="Wrap"/>

        <StackPanel Grid.Row="7" Grid.Column="0" Grid.ColumnSpan="3"
                    Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="Create" IsDefault="True" Click="OnCreateClick" Margin="0,0,8,0"/>
            <Button Content="Cancel" IsCancel="True"/>
        </StackPanel>
    </Grid>
</Window>
