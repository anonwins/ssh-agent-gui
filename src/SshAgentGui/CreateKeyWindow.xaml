<Window x:Class="SshAgentGui.CreateKeyWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Create key"
        Width="520"
        MinWidth="480"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Background="{StaticResource BgBrush}"
        Foreground="{StaticResource TextBrush}"
        FontFamily="Segoe UI"
        UseLayoutRounding="True"
        SourceInitialized="OnSourceInitialized">
    <Grid Margin="20" Background="{StaticResource BgBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="20"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="100"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>

        <StackPanel Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="3" Orientation="Horizontal">
            <TextBlock Style="{StaticResource Glyph}" Text="&#xE948;" FontSize="20"
                       Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center"/>
            <TextBlock Text="New OpenSSH key" FontSize="16" FontWeight="SemiBold" Margin="10,0,0,0" VerticalAlignment="Center"/>
        </StackPanel>

        <Label Grid.Row="2" Grid.Column="0" Content="Type"
               VerticalAlignment="Center" Margin="0,0,0,10"/>
        <ComboBox x:Name="TypeBox" Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2"
                  VerticalAlignment="Center" Margin="0,0,0,10" SelectedIndex="0" SelectionChanged="OnTypeChanged">
            <ComboBoxItem Content="Ed25519"/>
            <ComboBoxItem Content="RSA 4096"/>
        </ComboBox>

        <Label Grid.Row="3" Grid.Column="0" Content="File"
               VerticalAlignment="Center" Margin="0,0,0,10"/>
        <TextBox x:Name="PathBox" Grid.Row="3" Grid.Column="1"
                 VerticalAlignment="Center" Margin="0,0,8,10"/>
        <Button Grid.Row="3" Grid.Column="2" Click="OnBrowseClick"
                VerticalAlignment="Center" Margin="0,0,0,10">
            <StackPanel Orientation="Horizontal">
                <TextBlock Style="{StaticResource Glyph}" Text="&#xE8B7;"/>
                <TextBlock Text="Browse" Margin="8,0,0,0" VerticalAlignment="Center"
                           Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
            </StackPanel>
        </Button>

        <Label Grid.Row="4" Grid.Column="0" Content="Comment"
               VerticalAlignment="Center" Margin="0,0,0,10"/>
        <TextBox x:Name="CommentBox" Grid.Row="4" Grid.Column="1" Grid.ColumnSpan="2"
                 VerticalAlignment="Center" Margin="0,0,0,10"/>

        <Label Grid.Row="5" Grid.Column="0" Content="Passphrase"
               VerticalAlignment="Center" Margin="0,0,0,10"/>
        <PasswordBox x:Name="PassphraseBox" Grid.Row="5" Grid.Column="1" Grid.ColumnSpan="2"
                     VerticalAlignment="Center" Margin="0,0,0,10" PasswordChanged="OnPassphraseChanged"/>

        <Label Grid.Row="6" Grid.Column="0" Content="Confirm"
               VerticalAlignment="Center" Margin="0,0,0,10"/>
        <PasswordBox x:Name="ConfirmBox" Grid.Row="6" Grid.Column="1" Grid.ColumnSpan="2"
                     VerticalAlignment="Center" Margin="0,0,0,10" PasswordChanged="OnPassphraseChanged"/>

        <CheckBox x:Name="LoadBox" Grid.Row="7" Grid.Column="1" Grid.ColumnSpan="2"
                  Margin="0,4,0,10" Content="Load into agent now" IsChecked="True"/>

        <Label Grid.Row="8" Grid.Column="0" Content="Auto-unload"
               VerticalAlignment="Center" Margin="0,0,0,10"
               IsEnabled="{Binding IsChecked, ElementName=LoadBox}"/>
        <ComboBox x:Name="LifetimeBox" Grid.Row="8" Grid.Column="1" Grid.ColumnSpan="2"
                  VerticalAlignment="Center" Margin="0,0,0,10"
                  IsEnabled="{Binding IsChecked, ElementName=LoadBox}"
                  SelectionChanged="OnLifetimeChanged"
                  ToolTip="Windows ssh-agent ignores key lifetimes. This app may unload the key while it is running."/>

        <TextBlock x:Name="ErrorText" Grid.Row="9" Grid.Column="0" Grid.ColumnSpan="3"
                   Margin="0,12,0,0" Foreground="{StaticResource DangerBrush}" TextWrapping="Wrap"/>

        <StackPanel Grid.Row="10" Grid.Column="0" Grid.ColumnSpan="3"
                    Orientation="Horizontal" HorizontalAlignment="Right"
                    Margin="0,16,0,0">
            <Button IsCancel="True" Margin="0,0,8,0">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Style="{StaticResource Glyph}" Text="&#xE711;"/>
                    <TextBlock Text="Cancel" Margin="8,0,0,0" VerticalAlignment="Center"
                               Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                </StackPanel>
            </Button>
            <Button Style="{StaticResource PrimaryButton}" IsDefault="True" Click="OnCreateClick">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Style="{StaticResource Glyph}" Text="&#xE948;"/>
                    <TextBlock Text="Create" Margin="8,0,0,0" VerticalAlignment="Center"
                               Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                </StackPanel>
            </Button>
        </StackPanel>
    </Grid>
</Window>
