<Window x:Class="SshAgentGui.SignConfirmWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:SshAgentGui"
        Title="Confirm signature"
        Width="540"
        MinWidth="500"
        SizeToContent="Height"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        ShowInTaskbar="True"
        Topmost="True"
        Background="{StaticResource BgBrush}"
        Foreground="{StaticResource TextBrush}"
        FontFamily="Segoe UI"
        UseLayoutRounding="True"
        SourceInitialized="OnSourceInitialized">
    <Window.Resources>
        <Style x:Key="IdentityWell" TargetType="Border">
            <Setter Property="Width" Value="40"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Background" Value="{StaticResource SurfaceBrush}"/>
            <Setter Property="VerticalAlignment" Value="Top"/>
        </Style>
    </Window.Resources>
    <DockPanel Margin="20" Background="{StaticResource BgBrush}">
        <StackPanel DockPanel.Dock="Top">
            <TextBlock Text="Allow this signature?" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,14"/>

            <Border Style="{StaticResource Card}" Padding="14" Margin="0,0,0,14">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border x:Name="IconWell" Style="{StaticResource IdentityWell}">
                            <Grid>
                                <Image x:Name="CallerIcon"
                                       Width="32" Height="32"
                                       Stretch="Uniform"
                                       RenderOptions.BitmapScalingMode="HighQuality"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       Visibility="Collapsed"/>
                                <TextBlock x:Name="CallerGlyph"
                                           Style="{StaticResource Glyph}"
                                           Text="&#xE756;"
                                           FontSize="18"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           Foreground="{StaticResource MutedBrush}"/>
                            </Grid>
                        </Border>
                        <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                            <TextBlock x:Name="CallerName"
                                       FontWeight="SemiBold"
                                       FontSize="14"
                                       TextWrapping="Wrap"/>
                            <TextBlock x:Name="CallerSubtitle"
                                       Foreground="{StaticResource MutedBrush}"
                                       FontSize="12"
                                       TextWrapping="Wrap"
                                       TextTrimming="CharacterEllipsis"
                                       Margin="0,2,0,0"
                                       Visibility="Collapsed"/>
                        </StackPanel>
                    </Grid>
                    <StackPanel x:Name="DetailsStack" Margin="0,12,0,0" Visibility="Collapsed">
                        <TextBlock x:Name="ProcessRow"
                                   FontSize="13"
                                   TextWrapping="Wrap"
                                   Visibility="Collapsed"/>
                        <local:PackLeftPanel x:Name="PathRow" Visibility="Collapsed">
                            <TextBlock x:Name="PathValue"
                                       local:PackLeftPanel.IsFill="True"
                                       FontSize="12"
                                       FontFamily="Cascadia Mono, Consolas"
                                       Foreground="{StaticResource MutedBrush}"
                                       TextWrapping="Wrap"
                                       MaxHeight="36"
                                       TextTrimming="CharacterEllipsis"
                                       Cursor="Hand"
                                       MouseLeftButtonUp="OnPathClick"/>
                            <TextBlock Style="{StaticResource CopyCheck}"/>
                        </local:PackLeftPanel>
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}" Padding="14">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Border x:Name="KeyWell" Style="{StaticResource IdentityWell}">
                        <TextBlock Style="{StaticResource Glyph}"
                                   Text="&#xE192;"
                                   FontSize="18"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   Foreground="{StaticResource MutedBrush}"/>
                    </Border>
                    <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                        <local:PackLeftPanel>
                            <Border x:Name="KeyTypePill" Style="{StaticResource Pill}" Visibility="Collapsed">
                                <TextBlock x:Name="KeyTypeText" Foreground="{StaticResource MutedBrush}" FontSize="11"/>
                            </Border>
                            <TextBlock x:Name="KeyText"
                                       local:PackLeftPanel.IsFill="True"
                                       FontWeight="SemiBold"
                                       FontSize="14"
                                       TextWrapping="NoWrap"
                                       TextTrimming="CharacterEllipsis"
                                       VerticalAlignment="Center"/>
                        </local:PackLeftPanel>
                        <local:PackLeftPanel x:Name="FingerprintRow" Margin="0,4,0,0" Visibility="Collapsed">
                            <TextBlock x:Name="FingerprintText"
                                       local:PackLeftPanel.IsFill="True"
                                       TextWrapping="NoWrap"
                                       TextTrimming="CharacterEllipsis"
                                       Foreground="{StaticResource MutedBrush}"
                                       FontFamily="Cascadia Mono, Consolas"
                                       FontSize="11"
                                       Cursor="Hand"
                                       ToolTip="Copy fingerprint"
                                       MouseLeftButtonUp="OnFingerprintClick"/>
                            <TextBlock Style="{StaticResource CopyCheck}"/>
                        </local:PackLeftPanel>
                    </StackPanel>
                </Grid>
            </Border>
        </StackPanel>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button x:Name="DenyButton" IsCancel="True" Margin="0,0,8,0" Click="OnDenyClick">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Style="{StaticResource Glyph}" Text="&#xE711;"/>
                    <TextBlock Text="Deny" Margin="8,0,0,0" VerticalAlignment="Center"
                               Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                </StackPanel>
            </Button>
            <Button Style="{StaticResource PrimaryButton}" Click="OnAllowClick">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Style="{StaticResource Glyph}" Text="&#xE73E;"/>
                    <TextBlock Text="Allow" Margin="8,0,0,0" VerticalAlignment="Center"
                               Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                </StackPanel>
            </Button>
        </StackPanel>
    </DockPanel>
</Window>
