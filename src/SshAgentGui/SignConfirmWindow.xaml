<Window x:Class="SshAgentGui.SignConfirmWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Confirm signature"
        Width="460"
        MinWidth="420"
        SizeToContent="Height"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        ShowInTaskbar="True"
        Topmost="True"
        Background="{StaticResource BgBrush}"
        Foreground="{StaticResource TextBrush}"
        FontFamily="Segoe UI"
        UseLayoutRounding="True"
        SourceInitialized="OnSourceInitialized">
    <DockPanel Margin="20" Background="{StaticResource BgBrush}">
        <StackPanel DockPanel.Dock="Top">
            <TextBlock Text="Allow this signature?" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,8"/>
            <TextBlock Text="A program wants to use a key from the agent."
                       TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" Margin="0,0,0,12"/>
            <TextBlock x:Name="KeyText" TextWrapping="Wrap" FontWeight="SemiBold" Margin="0,0,0,4"/>
            <TextBlock x:Name="FingerprintText" TextWrapping="Wrap" TextTrimming="CharacterEllipsis"
                       Foreground="{StaticResource MutedBrush}" FontFamily="Cascadia Mono, Consolas" FontSize="11"/>
        </StackPanel>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button x:Name="DenyButton" IsCancel="True" Margin="0,0,8,0" Click="OnDenyClick">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Style="{StaticResource Glyph}" Text="&#xE711;"/>
                    <TextBlock Text="Deny" Margin="8,0,0,0" VerticalAlignment="Center"
                               Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                </StackPanel>
            </Button>
            <Button Style="{StaticResource PrimaryButton}" Click="OnAllowClick">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Style="{StaticResource Glyph}" Text="&#xE73E;"/>
                    <TextBlock Text="Allow" Margin="8,0,0,0" VerticalAlignment="Center"
                               Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                </StackPanel>
            </Button>
        </StackPanel>
    </DockPanel>
</Window>
