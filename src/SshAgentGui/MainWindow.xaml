<Window x:Class="SshAgentGui.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SSH Agent GUI"
        Height="580"
        Width="880"
        MinHeight="420"
        MinWidth="720"
        UseLayoutRounding="True"
        Background="{StaticResource BgBrush}"
        Foreground="{StaticResource TextBrush}"
        FontFamily="Segoe UI"
        StateChanged="OnStateChanged"
        SourceInitialized="OnSourceInitialized"
        Closing="OnClosing">
    <DockPanel Background="{StaticResource BgBrush}">
        <Border DockPanel.Dock="Bottom"
                Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,1,0,0"
                Padding="12,6">
            <TextBlock Text="{Binding StatusText}"
                       Foreground="{StaticResource MutedBrush}"
                       TextTrimming="CharacterEllipsis"/>
        </Border>

        <Grid Margin="16" Background="{StaticResource BgBrush}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="16"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal">
                    <Button Style="{StaticResource PrimaryButton}" Click="OnCreateKeyClick" IsEnabled="{Binding IsIdle}" Margin="0,0,8,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Glyph}" Text="&#xE948;"/>
                            <TextBlock Text="Create key" Margin="8,0,0,0" VerticalAlignment="Center"
                                       Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                        </StackPanel>
                    </Button>
                    <Button Click="OnAddKeyClick" IsEnabled="{Binding IsIdle}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Glyph}" Text="&#xE8E5;"/>
                            <TextBlock Text="Load key" Margin="8,0,0,0" VerticalAlignment="Center"
                                       Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
                <Button Grid.Column="1"
                        Style="{StaticResource CountChip}"
                        Click="OnRefreshClick"
                        IsEnabled="{Binding IsIdle}"
                        ToolTip="Refresh"
                        HorizontalAlignment="Right">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource GlyphSmall}" Text="&#xE72C;"
                                   VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding LoadedCountText}" Margin="8,0,0,0" VerticalAlignment="Center"
                                   Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                    </StackPanel>
                </Button>
            </Grid>

            <Grid Grid.Row="2">
                <ItemsControl ItemsSource="{Binding Identities}"
                              IsEnabled="{Binding IsIdle}"
                              Visibility="{Binding HasKeys, Converter={StaticResource BoolToVis}}"
                              VirtualizingPanel.IsVirtualizing="True"
                              VirtualizingPanel.VirtualizationMode="Recycling"
                              ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                              ScrollViewer.VerticalScrollBarVisibility="Auto">
                    <ItemsControl.Template>
                        <ControlTemplate TargetType="ItemsControl">
                            <ScrollViewer Background="Transparent"
                                          HorizontalScrollBarVisibility="Disabled"
                                          VerticalScrollBarVisibility="Auto"
                                          CanContentScroll="True">
                                <ItemsPresenter/>
                            </ScrollViewer>
                        </ControlTemplate>
                    </ItemsControl.Template>
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <VirtualizingStackPanel/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Padding="10,6" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Background" Value="Transparent"/>
                                        <Style.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Background" Value="{StaticResource SurfaceBrush}"/>
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" MinWidth="120"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <DockPanel LastChildFill="True" VerticalAlignment="Center" Margin="0,0,8,0">
                                        <Border DockPanel.Dock="Left" Style="{StaticResource Pill}" Background="{StaticResource GhostFillBrush}">
                                            <TextBlock Text="{Binding KeyType}" Foreground="{StaticResource MutedBrush}" FontSize="11"/>
                                        </Border>
                                        <TextBlock Text="{Binding DisplayComment}" FontWeight="SemiBold"
                                                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                    </DockPanel>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                        <Button Style="{StaticResource RowButton}" Click="OnCopyClick"
                                                ToolTip="Copy public key" Margin="0,0,6,0">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Style="{StaticResource GlyphSmall}" Text="&#xE8C8;"/>
                                                <TextBlock Text="Copy" Margin="6,0,0,0" VerticalAlignment="Center"
                                                           Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                                            </StackPanel>
                                        </Button>
                                        <Button Style="{StaticResource RowDangerButton}" Click="OnUnloadClick">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Style="{StaticResource GlyphSmall}" Text="&#xE74D;"/>
                                                <TextBlock Text="Unload" Margin="6,0,0,0" VerticalAlignment="Center"
                                                           Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                                            </StackPanel>
                                        </Button>
                                    </StackPanel>
                                    <TextBlock Grid.Row="1" Grid.ColumnSpan="2"
                                               Text="{Binding Fingerprint}"
                                               ToolTip="{Binding Fingerprint}"
                                               Foreground="{StaticResource MutedBrush}"
                                               FontFamily="Cascadia Mono, Consolas"
                                               FontSize="11"
                                               VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis"
                                               Margin="0,4,0,0"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <Border VerticalAlignment="Center" HorizontalAlignment="Stretch" Padding="32">
                    <Border.Style>
                        <Style TargetType="Border" BasedOn="{StaticResource Card}">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsEmpty}" Value="True">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <StackPanel HorizontalAlignment="Center" MaxWidth="420">
                        <TextBlock Style="{StaticResource GlyphLarge}" Text="&#xE192;"
                                   HorizontalAlignment="Center" Margin="0,0,0,12"/>
                        <TextBlock Text="No keys" FontSize="18" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                        <TextBlock Text="Create a new key or load an existing file to the agent."
                                   Foreground="{StaticResource MutedBrush}"
                                   TextAlignment="Center" TextWrapping="Wrap" Margin="0,8,0,0"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
    </DockPanel>
</Window>
